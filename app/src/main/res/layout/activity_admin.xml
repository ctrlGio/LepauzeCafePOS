<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEE9DF">

    <!-- Main Workspace Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Top Header Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="#817060"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp">

                <ImageButton
                    android:id="@+id/btnToggleSidebar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="16dp"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:background="@drawable/bg_hamburger_button"
                    android:contentDescription="Toggle Navigation Sidebar"
                    android:src="@drawable/ic_menu" />

                <TextView
                    android:id="@+id/tvHeaderTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="LePauze Coffee - Dashboard Overview"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Dashboard-->
                <LinearLayout
                    android:id="@+id/layoutDashboardContent"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Welcome to Admin Dashboard"
                        android:textColor="#1A1F17"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Menu -->
                <LinearLayout
                    android:id="@+id/layoutMenuContent"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <Button
                            android:id="@+id/btnAddItem"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:backgroundTint="#16A34A"
                            android:text="+ Add Menu Item"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:layout_marginEnd="12dp" />

                        <Button
                            android:id="@+id/btnArchiveSelected"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:backgroundTint="#555555"
                            android:text="Archive Selected"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:layout_marginEnd="12dp" />

                        <Button
                            android:id="@+id/btnViewArchive"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:backgroundTint="#817060"
                            android:text="View Archive"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="#D6CEBE"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <CheckBox
                            android:id="@+id/headerCheckbox"
                            android:layout_width="32dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="16dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.6"
                            android:text="Item Name"
                            android:textColor="#1A1F17"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.1"
                            android:text="Category"
                            android:textColor="#1A1F17"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.0"
                            android:text="Price"
                            android:textColor="#1A1F17"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.0"
                            android:text="Cost"
                            android:textColor="#1A1F17"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.9"
                            android:text="Margin"
                            android:textColor="#1A1F17"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="Actions"
                            android:textColor="#1A1F17"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#FFFFFF">

                        <LinearLayout
                            android:id="@+id/menuItemsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </ScrollView>
                </LinearLayout>

                <!-- Sales-->
                <LinearLayout
                    android:id="@+id/layoutSalesContent"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sales Records &amp; Analytics"
                        android:textColor="#1A1F17"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Employee -->
                <LinearLayout
                    android:id="@+id/layoutEmployeeContent"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Employee Directory &amp; Shifts"
                        android:textColor="#1A1F17"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Customer -->
                <LinearLayout
                    android:id="@+id/layoutCustomerContent"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <Button
                            android:id="@+id/btnAddCustomer"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:backgroundTint="#16A34A"
                            android:text="+ Add Purchase Record"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:layout_marginEnd="12dp" />

                        <Button
                            android:id="@+id/btnDeleteCustomerSelected"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:backgroundTint="#555555"
                            android:text="Archive Selected"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            android:layout_marginEnd="12dp" />

                        <Button
                            android:id="@+id/btnViewCustomerArchive"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:backgroundTint="#817060"
                            android:text="View Archive"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="#D6CEBE"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <CheckBox
                            android:id="@+id/custHeaderCheckbox"
                            android:layout_width="32dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="16dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.6"
                            android:text="Customer Name"
                            android:textColor="#1A1F17"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.4"
                            android:text="Served By"
                            android:textColor="#1A1F17"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.3"
                            android:text="Date"
                            android:textColor="#1A1F17"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.6"
                            android:text="Orders &amp; Qty"
                            android:textColor="#1A1F17"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.0"
                            android:text="Total Cost"
                            android:textColor="#1A1F17"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="100dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="Actions"
                            android:textColor="#1A1F17"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#FFFFFF">

                        <LinearLayout
                            android:id="@+id/customerItemsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </ScrollView>
                </LinearLayout>

            </FrameLayout>
        </LinearLayout>

        <!-- Dimming Backdrop Overlay -->
        <View
            android:id="@+id/sidebarDimOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:background="#99000000"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Collapsible Overlay Sidebar (Hidden by default) -->
    <LinearLayout
        android:id="@+id/sidebarContainer"
        android:layout_width="250dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#1A1F17"
        android:clickable="true"
        android:elevation="8dp"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Admin"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Sidebar Navigation Buttons -->
        <Button
            android:id="@+id/btnDashboard"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:backgroundTint="#2A3126"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:text="Dashboard"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnMenu"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:backgroundTint="#2A3126"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:text="Menu Management"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnSales"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:backgroundTint="#2A3126"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:text="Sales Records"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnEmployee"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:backgroundTint="#2A3126"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:text="Employee Directory"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnCustomer"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="#2A3126"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:text="Customer Base"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Logout Button -->
        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="#EA2A2A"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:text="Logout"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>