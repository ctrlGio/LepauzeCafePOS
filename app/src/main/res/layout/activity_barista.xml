<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F4F6">

    <!-- ==================== 1. TOP TOOLBAR ==================== -->
    <include
        android:id="@+id/include_toolbar"
        layout="@layout/brt_toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/include_checkout_sidebar" />


    <!-- ==================== 2. LEFT SIDE: MENU / CATALOG AREA ==================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_catalog_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/include_toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/include_checkout_sidebar">

        <!-- Placeholder for your menu grid / categories later -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Product Catalog Area"
            android:textColor="#9CA3AF"
            android:textSize="16sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- ==================== 3. RIGHT SIDE: CHECKOUT SIDEBAR (Stretched to Top) ==================== -->
    <include
        android:id="@+id/include_checkout_sidebar"
        layout="@layout/layout_checkout_sidebar"
        android:layout_width="380dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>