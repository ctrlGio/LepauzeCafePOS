<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer soft green ring -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#DCFCE7" />
            <size
                android:width="18dp"
                android:height="18dp" />
        </shape>
    </item>

    <!-- Inner solid green dot -->
    <item
        android:bottom="5dp"
        android:left="5dp"
        android:right="5dp"
        android:top="5dp">
        <shape android:shape="oval">
            <solid android:color="#15803D" />
        </shape>
    </item>
</layer-list>